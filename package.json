{
  "name": "channelvault",
  "version": "0.1.0",
  "description": "Git-style pull/push/diff for Mirth Connect (NextGen Connect / OIE / BridgeLink). Explodes a server config into a git-friendly directory tree and back.",
  "author": "Michael L. Hobbs",
  "license": "MIT",
  "type": "module",
  "bin": {
    "channelvault": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^18.0.3",
    "fast-xml-parser": "^4.5.0",
    "tough-cookie": "^5.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mirth",
    "mirth-connect",
    "nextgen-connect",
    "open-integration-engine",
    "bridgelink",
    "hl7",
    "healthcare",
    "cli",
    "gitops"
  ]
}
